play() {
    mpv --playlist="$HOME/Musik/$1.txt"
}

alias music-on='mpv --playlist=~/Musik/coding.txt'
#alias docker-up='sudo ln -s /etc/sv/docker /var/service/ && sudo sv start docker'
#alias docker-down='sudo sv stop docker && sudo rm /var/service/docker'
alias docker-up='sudo sv start docker'
alias docker-down='sudo sv stop docker'
alias cc="sudo sh -c 'echo 3 > /proc/sys/vm/drop_caches'"
update() {
    sudo xbps-install -Su && sudo xbps-remove -Oo
}
update-local() {
    "$HOME/dotfiles/update-packages"
}
kernel-purge() {
    local versions keep version
    versions=$(vkpurge list) || return
    if [ -z "$versions" ]; then
        printf 'Keine alten Kernelversionen zum Entfernen gefunden.\n'
        return
    fi

    keep=$(printf '%s\n' "$versions" | LC_ALL=C sort -V | tail -n 1)
    set --
    while IFS= read -r version; do
        [ -n "$version" ] && [ "$version" != "$keep" ] && set -- "$@" "$version"
    done <<< "$versions"

    printf 'Rückfallversion bleibt erhalten: %s\n' "$keep"
    if [ "$#" -eq 0 ]; then
        printf 'Keine weiteren alten Kernelversionen zum Entfernen gefunden.\n'
        return
    fi
    sudo vkpurge rm "$@"
}
alias open='xdg-open'
alias ll='ls -la'
if command -v nvim >/dev/null 2>&1; then
    alias vi='nvim'
fi
if command -v tmux >/dev/null 2>&1; then
  [ -z "$TMUX" ] && exec tmux new-session -A -s main
fi