# turnstile/runit runtime state (created inside the linked service dir)
supervise/
.crush/

# Session-Env wird zur Laufzeit von turnstile geschrieben
.config/service-env/*
!.config/service-env/.gitignore

# Goose: Secrets liegen im Keyring bzw. secrets.yaml, OAuth-Tokens je Provider
.config/goose/secrets.yaml*
.config/goose/*_oauth/
.config/goose/chatgpt_codex/

# Sicherungen und Editor-Muell
*.bak
*.bak-*
*.backup
*.orig
*~
.DS_Store

# dbus service runtime logs
.config/service/*/log/
