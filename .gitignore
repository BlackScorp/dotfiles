# turnstile/runit runtime state (created inside the linked service dir)
supervise/
.crush/

# Session-Env wird zur Laufzeit von turnstile geschrieben
.config/service-env/*
!.config/service-env/.gitignore

# Von Noctalia erzeugte Theme-Dateien (Quelle: .local/state/noctalia/settings.toml)
.config/mango/noctalia.conf
.config/gtk-3.0/gtk.css
.config/gtk-3.0/noctalia*.css
.config/gtk-4.0/gtk.css
.config/gtk-4.0/noctalia*.css
.config/qt5ct/colors/noctalia.conf
.config/qt6ct/colors/noctalia.conf

# Sicherungen und Editor-Muell
*.bak
*.bak-*
*.backup
*.orig
*~
.DS_Store

# Goose: Secrets liegen im Keyring bzw. secrets.yaml, OAuth-Tokens je Provider
.config/goose/secrets.yaml*
.config/goose/*_oauth/
.config/goose/chatgpt_codex/
