[Desktop Entry]
Type=Application
Name=Noctalia Image Annotator
Comment=Open images in Noctalia's overlay viewer
Exec=noctalia msg annotate --no-annotate %f
Icon=noctalia
Terminal=false
StartupNotify=false
MimeType=image/bmp;image/gif;image/vnd.microsoft.icon;image/jpeg;image/jpg;image/jxl;image/png;image/qoi;image/svg+xml;image/x-tga;image/webp;image/vnd.wap.wbmp;image/x-portable-anymap;image/x-portable-graymap;image/x-portable-pixmap;
